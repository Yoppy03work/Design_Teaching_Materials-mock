# ───────────────────────────────────────────────────────────
# 環境変数の雛形。`.env.local` にコピーして値を埋める。
# 認証後回しフェーズでは未設定でもアプリは起動する（データ永続化には必要）。
# ───────────────────────────────────────────────────────────

# Supabase（クライアント/サーバー共通で参照）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase サービスロールキー（サーバー処理専用・絶対にクライアントへ露出させない）
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic（Phase 4 のAI壁打ちで使用。/api/ai のサーバー側でのみ参照）
ANTHROPIC_API_KEY=
